{
  "name": "deskside-app",
  "private": true,
  "version": "1.0.0",
  "description": "Deskside: visualiza la actividad de Claude Code como una oficina en pixel art",
  "author": "Guiille99",
  "license": "MIT",
  "type": "module",
  "main": "main/main.js",
  "scripts": {
    "build": "vite build",
    "start": "vite build && electron .",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/*.test.js\"",
    "dist": "vite build && electron-builder --dir",
    "installer": "vite build && electron-builder"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "phaser": "^3.90.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "build": {
    "appId": "local.deskside",
    "productName": "Deskside",
    "directories": {
      "output": "release"
    },
    "files": [
      "main/**",
      "hook/**",
      "dist/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../backend/src",
        "to": "backend/src"
      },
      {
        "from": "../backend/package.json",
        "to": "backend/package.json"
      },
      {
        "from": "../LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "../THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      }
    ],
    "icon": "build/deskside-logo.png",
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "include": "build/installer.nsh",
      "oneClick": false,
      "perMachine": false
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "deb",
      "category": "Development",
      "maintainer": "Guiille99"
    }
  }
}
